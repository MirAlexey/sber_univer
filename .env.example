# GigaChat. Без ключей тесты и офлайн-демо работают на дублях (HashEmbedder).
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_B2B
GIGACHAT_VERIFY_SSL_CERTS=False

# Модели
AGENT_MODEL=GigaChat-Pro
EMBED_MODEL=EmbeddingsGigaChat

# Управление контекстом под бюджет
DIALOG_BUDGET_TOKENS=3200
MEMORY_BUDGET_TOKENS=700
RECALL_TOP_K=4

# По умолчанию поиск ведётся "на сегодня"; можно зафиксировать дату для демо:
# DEFAULT_AS_OF=2026-06-10
DEFAULT_AS_OF=

# Объёмная переработка памяти вне диалога
CONSOLIDATE_MIN_AGE_DAYS=1

# Langfuse - по желанию (аналогично шаблону задания 3)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Персистентность долговременной памяти между перезапусками (пусто = только в памяти)
MEMORY_FILE=memory_dump.json
